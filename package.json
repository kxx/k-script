{
  "name": "k-script",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "etax-helper:dev": "pnpm -r --filter=./packages/etax-helper dev",
    "qixin-helper:dev": "pnpm -r --filter=./packages/qixin-helper dev",
    "showdoc-helper:dev": "pnpm -r --filter=./packages/showdoc-helper dev",
    "build": "pnpm -r --filter=./packages/* build",
    "etax-helper:test": "pnpm --filter etax-helper test",
    "etax-helper:build": "pnpm --filter etax-helper build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.0.6",
    "axios": "^1.3.4",
    "jquery": "^3.6.3",
    "element-plus": "^2.5.0",
    "vue": "^3.2.47"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "vite": "^4.1.1"
  },
  "packageManager": "pnpm@9.15.9"
}
